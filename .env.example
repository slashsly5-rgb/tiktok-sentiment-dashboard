# =============================================================================
# TikTok Sentiment Dashboard - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Database (REQUIRED)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------

# Choose your LLM provider: "mistral" (recommended) or "openai"
LLM_PROVIDER=mistral

# -----------------------------------------------------------------------------
# Mistral AI Configuration (RECOMMENDED - Cheaper & Faster)
# -----------------------------------------------------------------------------
# Get your key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key-here

# Model options:
#   - mistral-small-latest (RECOMMENDED - Fast & Cheap)
#   - mistral-medium-latest (More capable)
#   - mistral-large-latest (Most powerful)
MISTRAL_MODEL=mistral-small-latest

# Advanced settings (optional)
MISTRAL_MAX_TOKENS=1000
MISTRAL_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# OpenAI Configuration (OPTIONAL - Use if you prefer OpenAI)
# -----------------------------------------------------------------------------
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Apify Configuration (OPTIONAL - Advanced scraping fallback)
# -----------------------------------------------------------------------------
# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Apify Task URLs (Pre-configured for this project)
APIFY_TASK_URL_PRIMARY=https://api.apify.com/v2/actor-tasks/...
APIFY_TASK_URL_FALLBACK=https://api.apify.com/v2/actor-tasks/...

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False

# Scraper Configuration
SCRAPER_HEADLESS=True
SCRAPER_MAX_VIDEOS=5
SCRAPER_MAX_COMMENTS=20

# Chat Configuration
CHAT_SESSION_TIMEOUT=3600
MAX_CHAT_HISTORY_LENGTH=50
